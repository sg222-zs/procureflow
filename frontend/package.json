    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.2"
  }
